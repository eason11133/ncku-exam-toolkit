      "conditions": [
        "編譯器支援",
        "測試資料會觸發相關路徑"
      ],
      "tradeoffs": [
        "明顯增加執行成本",
        "不能拿這版和 release 版直接比較速度"
      ],
      "behavior": "對相同輸入做正確性測試，記錄 stack trace。",
      "metrics": [
        "越界錯誤",
        "未定義行為",
        "測試通過率"
