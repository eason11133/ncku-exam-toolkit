    {
      "id": "move-work-outside",
      "title": "縮短 Critical Section",
      "aliases": [],
      "summary": "能移出的局部計算先做，只保留必要共享更新在鎖內。",
      "principle": "讓共享資料的原子更新時間短，減少其他執行緒等待。",
      "conditions": [
        "工作不依賴鎖內瞬間狀態",
        "同一批共享資料全部被一致保護"
      ],
      "tradeoffs": [
        "拆開可能破壞交易原子性",
        "鎖外的其他共享變數也要分析資料競爭"
      ],
      "behavior": "正確性優先：counter 應完整、sink 等其他共享狀態也要排查。",
      "metrics": [
        "counter",
        "總耗時",
        "CPU"
      ],
