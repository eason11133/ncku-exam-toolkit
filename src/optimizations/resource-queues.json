    {
      "id": "producer-consumer",
      "title": "減少高頻跨執行緒共享",
      "aliases": [],
      "summary": "使用明確的單向資料通道避免多處直接改共享狀態。",
      "principle": "讓資料所有權在 Producer / Consumer 之間交接，減少共同修改。",
      "conditions": [
        "有可明確分界的資料流",
        "可設計 shutdown 和 backpressure"
      ],
      "tradeoffs": [
        "需要額外排程",
        "若 queue 無界會爆記憶體"
      ],
      "behavior": "比對無損、無重複、必要先後順序。",
      "metrics": [
        "latency",
        "CPU",
        "RSS"
      ],
