    {
      "id": "condition-predicate-loop",
      "title": "用 Condition Variable 取代忙等",
      "aliases": [
        "pthread_cond_wait",
        "condition variable",
        "spurious wakeup"
      ],
      "summary": "在 Mutex 保護的條件不成立時睡眠等待，不持續輪詢。",
      "principle": "pthread_cond_wait 暫時放開 Mutex 並在回傳前重新取得；以 while 重新檢查 predicate。",
      "conditions": [
        "所有共享狀態都在相同同步規則下",
        "喚醒後使用 while 重檢"
      ],
      "tradeoffs": [
        "不一定更低延遲",
        "錯誤鎖範圍可能造成死鎖"
      ],
      "behavior": "即使有 spurious wakeup、close、競爭 Consumer 仍正確。",
      "metrics": [
        "CPU 使用率",
        "工作延遲",
        "正確性"
      ],
      "sources": [
        {
          "title": "POSIX pthread_cond_wait",
          "url": "https://man7.org/linux/man-pages/man3/pthread_cond_wait.3p.html"
        }
      ],
      "verified": false,
      "code": {
        "language": "c",
        "snippet": "pthread_mutex_lock(&q.mu);\nwhile (q.count == 0 && !q.closed)\n    pthread_cond_wait(&q.not_empty, &q.mu);\npthread_mutex_unlock(&q.mu);"
      },
      "articleId": "opt-cond-wait-predicate"
    },
