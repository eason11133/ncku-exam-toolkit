    {
      "id": "avoid-false-sharing",
      "title": "確認多執行緒 False Sharing",
      "aliases": [
        "cache line",
        "per-thread counters"
      ],
      "summary": "不同執行緒更新不同資料，但若在同一 cache line 可能互相干擾。",
      "principle": "分離頻繁更新的位置或改用 thread-local 彙總。",
      "conditions": [
        "先證實高頻共享 cache line",
        "平台允許量測"
      ],
      "tradeoffs": [
        "對齊 padding 增加記憶體",
        "盲目 padding 可能無效"
      ],
      "behavior": "保持結果一致，且測 CPU/吞吐量；不可假設 cache line 固定為 64 bytes。",
