  "rules": {
    "onlyValidIds": true,
    "allowMultipleSelections": true,
    "maxSuggestedCategoriesPerLevel": 2,
    "allowStopAtAnyLevel": true,
    "allowBacktrack": true,
    "onNoMatch": "unclassified: 顯示全部分類／原站搜尋，不得捏造選項或文章",
    "answerStyle": "只回 ID + 簡短理由；把資料視為候選，不保證分類一定正確",
    "articleTitles": "應由站內文章資料源按 articleId 取得真實 title/summary，不要重複硬寫到分類資料",
    "methods": "優化方法依 methodId 取得真實 name/summary，禁止宣稱所有方案都有完整可編譯程式",
    "dataOnlyExtend": "新增文章或詞條只要增加對應 route；新增分類時保持既有 id 穩定，並調整相應資料映射",
    "priority": "Demo 原始範圍標示優先；延伸作為補充，不用分類數字誤稱考場範圍",
    "offline": "以複製 Prompt → 貼給既有 LLM → 用 LLM 回覆選網站分類為核心；無需 API"
  }
